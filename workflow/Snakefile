from snakemake.utils import min_version
min_version("6.0")

import os
import sys
import glob

# Load config
configfile: "config/config.yaml"
#container: "docker://continuumio/miniconda3:23.10.0-1"

RESOURCES_DIR = config["RESOURCES_DIR"]
DATA_DIR = config["DATA_DIR"]
RESULTS_DIR = config["RESULTS_DIR"]
LOGS_DIR = config["LOGS_DIR"]
SAMPLES = config["SAMPLES"]

DEMULTIPLEX_SAMPLES = {}
for sample in SAMPLES.keys():
    file_prefix = SAMPLES[sample]['reads']
    for index in SAMPLES[sample].get('index_seqs', []):
        demux_key = f"{sample}_{index}"
        DEMULTIPLEX_SAMPLES[demux_key] = {
            'sample': sample,
            'index': index,
            'reads': f"{file_prefix}_{index}",
            'file_prefix': file_prefix,
        }

def get_demultiplexed_reads(wc):
    """
    This is input for rules that process demultiplexed reads (e.g. cutadapt, FastQC).

    Return path to demultiplexed reads for given sample wildcard.
    """

    demux_key = wc.sample
    if demux_key not in DEMULTIPLEX_SAMPLES:
        raise ValueError(f"Unknown demux sample: {demux_key}")

    info = DEMULTIPLEX_SAMPLES[demux_key]
    # Ensure the demultiplex checkpoint for the originating input sample ran
    chk = checkpoints.demultiplex.get(input_sample=info['sample'])
    
    # Determine output directory from checkpoint output
    out_dir = os.path.join(os.path.dirname(chk.output[0]), demux_key)

    # Return path to demultiplexed reads
    return os.path.join(out_dir, f"{info['reads']}.fastq.gz")

