# define sample dirs as output of demultiplexing
def get_sample_dirs(wc):
    return [
        os.path.join(DATA_DIR, input_sample)
        for input_sample in SAMPLES.keys()
    ]

wildcard_constraints:
    input_sample="|".join(SAMPLES.keys()),
    sample="|".join(DEMULTIPLEX_SAMPLES.keys()),
    sample_reads="|".join(
        [info['reads'] for info in DEMULTIPLEX_SAMPLES.values()]
    )

ruleorder:
    cutadapt > FastQC_trimmed


def get_demux_reads(sample):
    return DEMULTIPLEX_SAMPLES[sample]['reads']


def get_fastqc_targets(wc=None):
    """Return explicit FastQC HTML target paths for every demultiplexed sample.

    Building them here avoids trying to use expand with a function that
    returns values dependent on another wildcard.
    """
    targets = [
        os.path.join(RESULTS_DIR, "fastqc", demux_key, f"{info['reads']}_fastqc.html")
        for demux_key, info in DEMULTIPLEX_SAMPLES.items()
    ]
    return targets

def get_umi_reads_targets(wc=None):
    """Return explicit trimmed reads target paths for every demultiplexed sample.

    Building them here avoids trying to use expand with a function that
    returns values dependent on another wildcard.
    """
    targets = [
        os.path.join(RESULTS_DIR, "process_reads", demux_key, f"{info['reads']}_trim_umi.fastq.gz")
        for demux_key, info in DEMULTIPLEX_SAMPLES.items()
    ]
    return targets


def get_fastqc_trimmed_targets(wc=None):
    """Return explicit FastQC HTML target paths for every trimmed sample.

    Building them here avoids trying to use expand with a function that
    returns values dependent on another wildcard.
    """
    targets = [
        os.path.join(RESULTS_DIR, "fastqc", demux_key, f"{info['reads']}_trim_fastqc.html")
        for demux_key, info in DEMULTIPLEX_SAMPLES.items()
    ]
    return targets

