# use rule cutadapt from clip as clip_cutadapt with:
#     input:
#         fastq=get_demultiplexed_reads,
#     output:
#         fastq=os.path.join(RESULTS_DIR, "process_reads", "{sample}", "{sample_reads}_trim.fastq.gz"),
#     log: 
#         os.path.join(LOGS_DIR, "process_reads", "{sample}", "{sample_reads}_trim.log")
#     conda: 
#         None if "--use-singularity" in sys.argv else "envs/cutadapt.yaml"



rule all:
    input:
        get_fastqc_targets,
        get_fastqc_trimmed_targets,
        get_umi_reads_targets,
        

rule cutadapt:
    input:
      fastq=get_demultiplexed_reads,
    output:
      fastq=os.path.join(RESULTS_DIR, "process_reads", "{sample}", "{sample_reads}_trim.fastq.gz"),
    conda:
      None if "--use-singularity" in sys.argv else "envs/cutadapt.yaml"
    container:
      "docker://quay.io/biocontainers/cutadapt:3.5--py39h38f01e4_0"
    log: 
        os.path.join(LOGS_DIR, "process_reads", "{sample}", "{sample_reads}_cutadapt.log")
    threads: config["THR"]
    params:
      three_prime_adapter_sequence=config["THREE_PRIME_ADAPTER_SEQUENCE"],
      repeat_n_times=2,
      match_read_wildcards=18
    shell:
        """
        cutadapt -a {params.three_prime_adapter_sequence}  \
            -j {threads} -n {params.repeat_n_times}  \
            -m {params.match_read_wildcards}  \
            -o {output.fastq} {input.fastq}
        """

rule extract_UMIs:
    input:
      fastq=os.path.join(RESULTS_DIR, "process_reads", "{sample}", "{sample_reads}_trim.fastq.gz"),
    output:
      processed=os.path.join(RESULTS_DIR, "process_reads", "{sample}", "{sample_reads}_trim_umi.fastq.gz")
    container:
      "docker://quay.io/biocontainers/umi_tools:1.1.2--py310h1425a21_1"
    conda:
        None if  "--use-singularity" in sys.argv else "envs/umi-tools.yaml"
    log:
      os.path.join(LOGS_DIR, "umi_tools_extract", "{sample}", "{sample_reads}.log")
    resources:
      mem_mb_per_cpu='8G'
    params:
      pattern=lambda wc: config['UMI-BARCODE']
    shell:
      """
      umi_tools extract --stdin={input.fastq} --extract-method=string --bc-pattern={params.pattern:q} --log={log} --stdout {output.processed}
      """

# Define demultiplexing rule as a checkpoint to allow downstream rules to depend on its output
# Output of this rule can be accessed 
checkpoint demultiplex:
    input:
        r1=lambda wc: os.path.join(RESOURCES_DIR, wc.input_sample, f"{SAMPLES[wc.input_sample]['reads']}.fastq.gz"),
        index=lambda wc: os.path.join(RESOURCES_DIR, wc.input_sample, f"{SAMPLES[wc.input_sample]['index']}.fastq.gz")
    output:
        directory(os.path.join(DATA_DIR, "{input_sample}")),
    params:
        index_seqs=lambda wc: SAMPLES[wc.input_sample]["index_seqs"],
        max_hamming=lambda wc: SAMPLES[wc.input_sample].get("max_hamming", 0),
        log_level="DEBUG"
    log:
        os.path.join(LOGS_DIR, "demultiplex", "{input_sample}.log")
    container: 
        "docker://veroyols/biopython:latest"
    conda:
        None if "--use-singularity" in sys.argv else "envs/demultiplex.yaml"
    script:
        "scripts/demultiplex.py"

rule FastQC:
    input:
        get_demultiplexed_reads,
    output:
        os.path.join(RESULTS_DIR, "fastqc", "{sample}", "{sample_reads}_fastqc.html")
    params:
        out_dir=lambda wc: os.path.join(RESULTS_DIR, "fastqc", wc.sample)
    log:
        os.path.join(LOGS_DIR, "fastqc", "{sample}", "{sample_reads}.log")
    conda:
        None if "--use-singularity" in sys.argv else "envs/fastqc.yaml"
    container: 
        "docker://biocontainers/fastqc:v0.11.9_cv8"
    shell:
        """
            mkdir -p {params.out_dir}
            fastqc {input} --outdir {params.out_dir} > {log} 2>&1
        """

rule FastQC_trimmed:
    input:
        os.path.join(RESULTS_DIR, "process_reads", "{sample}", "{sample_reads}_trim.fastq.gz"),
    output:
        os.path.join(RESULTS_DIR, "fastqc", "{sample}", "{sample_reads}_trim_fastqc.html")
    params:
        out_dir=lambda wc: os.path.join(RESULTS_DIR, "fastqc", wc.sample)
    log:
        os.path.join(LOGS_DIR, "fastqc", "{sample}", "{sample_reads}_trim.log")
    conda:
        None if "--use-singularity" in sys.argv else "envs/fastqc.yaml"
    container: 
        "docker://biocontainers/fastqc:v0.11.9_cv8"
    shell:
        """
            mkdir -p {params.out_dir}
            fastqc {input} --outdir {params.out_dir} > {log} 2>&1
        """

